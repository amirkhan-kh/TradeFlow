# Production API host (docker-compose.prod.yml). Copy to .env and fill every value; never commit .env.

# Public API domain, DNS A record → this server. Caddy issues the HTTPS certificate automatically.
API_DOMAIN=api.example.uz
# Exact frontend origin (Vercel domain or your custom domain).
CORS_ORIGIN=https://tradeflow.example.uz

POSTGRES_USER=tradeflow
POSTGRES_DB=tradeflow
# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -hex 32  (≥ 32 bytes; changing it logs everyone out)
JWT_SECRET=
# openssl rand -hex 32  (encrypts integration secrets; set once and back it up)
SECRET_KEY=

ADMIN_USERNAME=admin
# Strong password for the first admin (created on first boot only).
ADMIN_PASSWORD=
# true = first boot fills the database with demo data (500+ products, 460 clients, 4000+ orders, demo users with password demo123).
SEED_DEMO=false

# ---- Vercel (frontend) → Project → Settings → Environment Variables ----
# API_INTERNAL_URL=https://api.example.uz
# NEXT_PUBLIC_SITE_URL=https://tradeflow.example.uz   (optional; defaults to the Vercel production domain)
# DEMO_LOGIN=manager/demo123                          (optional; shows a demo login hint on /login)
